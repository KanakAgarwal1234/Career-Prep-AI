# ─────────────────────────────────────────────────────────────────────────────
# CareerPrep AI — every variable is OPTIONAL. With none set, the app runs fully
# offline: deterministic ATS engine, rule-based interviewer, Web Speech voice,
# local demo accounts and a mock Stripe checkout.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (Vercel AI SDK) ── first configured key wins unless AI_PROVIDER is set
# AI_PROVIDER=openai            # openai | anthropic | offline
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=              # any OpenAI-compatible endpoint
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT_MS=45000
# LLM_RATE_LIMIT=30             # LLM calls per IP per 10 minutes (then offline fallback)

# ── High-fidelity voice (optional) ──
# ElevenLabs is preferred for TTS when set; OpenAI key also enables TTS + Whisper STT.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_STT_MODEL=whisper-1

# ── Supabase (auth, storage, history, entitlements) ── run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only — never expose
# NEXT_PUBLIC_SUPABASE_RESUME_BUCKET=resumes

# ── Stripe (Pro paywall) ── without these, checkout is mocked end to end
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=                # recurring price for Pro
STRIPE_WEBHOOK_SECRET=          # endpoint: /api/stripe/webhook
# STRIPE_MODE=subscription      # or "payment" for a one-off pass
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_PRO_PRICE_LABEL=$19
# NEXT_PUBLIC_PRO_INTERVAL_LABEL=month
